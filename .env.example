# ==============================================================================
# AI Study Copilot - Configuration Template (.env.example)
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# Application environment
APP_ENV=development
APP_VERSION=0.1.0
APP_PORT=8000

# LLM Provider configuration
# Options: 'mock' (default offline testing, free), 'gemini' (for production AI), 'recorded' (replay/record)
LLM_PROVIDER=mock
LLM_MODEL=mock-study-flash
LLM_API_KEY=
LLM_TIMEOUT_S=15

# Recorded provider & daily budget guardrails
RECORD_MODE=replay
RECORDINGS_DIR=tests/recordings
BUDGET_DAILY_USD=5.0
BUDGET_DAILY_CALLS=500
BUDGET_FILE=data/budget.json

# Reliability, Rate Limiting & Caching
AI_ENABLED=1
LLM_TOTAL_DEADLINE_S=45
LLM_MAX_RETRIES=2
LLM_MAX_CONCURRENCY=5
USER_RATE_LIMIT_RPM=20
BREAKER_THRESHOLD=3
BREAKER_RECOVERY_S=30
CACHE_TTL_S=3600

# Mock provider testing options
# MOCK_FAILURE_RATE: float from 0.0 to 1.0 (0.0 = always succeed)
MOCK_FAILURE_RATE=0.0
# MOCK_FAILURE_KIND: 'none', 'timeout', 'rate_limit', 'unavailable', 'invalid_json'
MOCK_FAILURE_KIND=none
MOCK_DELAY_MS=50

# Storage & Telemetry
DB_PATH=data/study.db
LOG_FILE=logs/app.log
LOG_LEVEL=INFO
