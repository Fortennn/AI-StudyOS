  "components": {
    "schemas": {
      "AuthRequest": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 32,
            "minLength": 3,
            "pattern": "^[a-zA-Z0-9_.-]+$",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 4,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "AuthRequest"
      },
      "AuthResponse": {
        "properties": {
          "user": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/UserPublic"
              },
              {
                "type": "null"
              }
            ]
          },
          "google_enabled": {
            "type": "boolean",
            "title": "Google Enabled",
            "default": false
          }
        },
        "type": "object",
        "title": "AuthResponse"
      },
      "Body_upload_document_api_upload_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_document_api_upload_post"
      },
      "ChatMessage": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "text": {
            "type": "string",
            "maxLength": 16000,
            "minLength": 1,
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "role",
          "text"
        ],
        "title": "ChatMessage"
      },
      "ChatRequest": {
        "properties": {
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "topic": {
            "type": "string",
            "title": "Topic",
            "default": "Загальна тема"
          },
          "context_text": {
            "type": "string",
            "title": "Context Text",
            "default": ""
          },
          "question": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 2,
            "title": "Question"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "type": "array",
            "title": "History"
          },
          "provider": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider"
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "ChatRequest"
      },
      "ChatResponse": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          }
        },
        "type": "object",
        "required": [
          "request_id",
          "answer"
        ],
        "title": "ChatResponse"
      },
      "FlashcardItem": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id",
            "description": "Унікальний порядковий номер картки"
          },
          "front": {
            "type": "string",
            "title": "Front",
            "description": "Питання або термін на лицьовій стороні"
          },
          "back": {
            "type": "string",
            "title": "Back",
            "description": "Визначення, відповідь або пояснення на зворотній стороні"
          },
          "category": {
            "type": "string",
            "title": "Category",
            "description": "Категорія складності або підтема",
            "default": "Основне"
          }
        },
        "type": "object",
        "required": [
          "id",
          "front",
          "back"
        ],
        "title": "FlashcardItem"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "provider": {
            "type": "string",
            "title": "Provider"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "mode": {
            "type": "string",
            "title": "Mode"
          },
          "storage": {
            "type": "string",
            "title": "Storage"
          },
          "extra": {
            "additionalProperties": true,
            "type": "object",
            "title": "Extra"
          },
          "uptime_s": {
            "type": "integer",
            "title": "Uptime S"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version",
          "provider",
          "model",
          "mode",
          "storage",
          "extra",
          "uptime_s"
        ],
        "title": "HealthResponse"
      },
      "QuizItem": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id",
            "description": "Порядковий номер питання"
          },
          "question": {
            "type": "string",
            "title": "Question",
            "description": "Текст питання"
          },
          "options": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 4,
            "minItems": 4,
            "title": "Options",
            "description": "Чотири варіанти відповіді (A, B, C, D)"
          },
          "correct_index": {
            "type": "integer",
            "maximum": 3.0,
            "minimum": 0.0,
            "title": "Correct Index",
            "description": "Індекс правильної відповіді (0..3)"
          },
          "explanation": {
            "type": "string",
            "title": "Explanation",
            "description": "Коротке пояснення правильної відповіді"
          }
        },
        "type": "object",
        "required": [
          "id",
          "question",
          "options",
          "correct_index",
          "explanation"
        ],
        "title": "QuizItem"
      },
      "SessionRecord": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "topic": {
            "type": "string",
            "title": "Topic"
          },
          "text_length": {
            "type": "integer",
            "title": "Text Length"
          },
          "card_count": {
            "type": "integer",
            "title": "Card Count"
          },
          "quiz_count": {
            "type": "integer",
            "title": "Quiz Count"
          },
          "pinned": {
            "type": "boolean",
            "title": "Pinned",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "id",
          "created_at",
          "topic",
          "text_length",
          "card_count",
          "quiz_count"
        ],
        "title": "SessionRecord"
      },
      "StudyKitResponse": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "default": "success"
          },
          "topic": {
            "type": "string",
            "title": "Topic"
          },
          "summary": {
            "$ref": "#/components/schemas/StudySummary"
          },
          "flashcards": {
            "items": {
              "$ref": "#/components/schemas/FlashcardItem"
            },
            "type": "array",
            "title": "Flashcards"
          },
          "quiz": {
            "items": {
              "$ref": "#/components/schemas/QuizItem"
            },
            "type": "array",
            "title": "Quiz"
          },
          "true_false": {
            "items": {
              "$ref": "#/components/schemas/TrueFalseItem"
            },
            "type": "array",
            "title": "True False"
          },
          "chat_history": {
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "type": "array",
            "title": "Chat History"
          },
          "provider_kind": {
            "type": "string",
            "enum": [
              "main",
              "fallback",
              "cache",
              "mock",
              "recorded"
            ],
            "title": "Provider Kind",
            "default": "mock"
          },
          "checks": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Checks"
          }
        },
        "type": "object",
        "required": [
          "request_id",
          "topic",
          "summary",
          "flashcards",
          "quiz"
        ],
        "title": "StudyKitResponse"
      },
      "StudyRequest": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 250000,
            "minLength": 10,
            "title": "Text",
            "description": "Текст конспекту або лекції для обробки"
          },
          "topic": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Topic",
            "description": "Назва теми або предмету",
            "default": "Загальна тема"
          },
          "card_count": {
            "type": "integer",
            "maximum": 30.0,
            "minimum": 0.0,
            "title": "Card Count",
            "description": "Кількість флеш-карток (0 = авто)",
            "default": 5
          },
          "quiz_count": {
            "type": "integer",
            "maximum": 25.0,
            "minimum": 0.0,
            "title": "Quiz Count",
            "description": "Кількість питань тесту (0 = авто)",
            "default": 5
          },
          "provider": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider",
            "description": "Опціональне перекриття провайдера (mock або gemini)"
          },
          "api_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Api Key",
            "description": "Опціональний API ключ для Gemini"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "StudyRequest"
      },
      "StudySummary": {
        "properties": {
          "tldr": {
            "type": "string",
            "title": "Tldr",
            "description": "Стисле резюме конспекту (3-4 речення)"
          },
          "key_takeaways": {
            "items": {
              "type": "string"
            },
